<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="total_inherit" inherit_id="website_sale.total">
        <xpath expr="//tr[@id='order_total_taxes']" position="after">
            <!-- Calcular el TOTAL de anticipos de todas las citas -->
            <t t-set="total_advance" t-value="0"/>
            <t t-set="advance_count" t-value="0"/>
            <t t-foreach="website_sale_order.website_order_line" t-as="line">
                <t t-if="line.calendar_booking_ids">
                    <t t-foreach="line.calendar_booking_ids" t-as="booking">
                        <t t-set="apt_type" t-value="booking.appointment_type_id"/>
                        <t t-if="apt_type and apt_type.advance_type == 'advance_percentage'">
                            <t t-set="total_advance" t-value="total_advance + (line.price_subtotal * apt_type.advance_percentage / 100)"/>
                            <t t-set="advance_count" t-value="advance_count + 1"/>
                        </t>
                        <t t-if="apt_type and apt_type.advance_type == 'fixed_import'">
                            <t t-set="total_advance" t-value="total_advance + apt_type.fixed_import"/>
                            <t t-set="advance_count" t-value="advance_count + 1"/>
                        </t>
                    </t>
                </t>
            </t>
            <!-- Mostrar UNA sola línea con el total de anticipos -->
            <t t-if="total_advance > 0">
                <tr id="tr_total_advance">
                    <td class="text-muted border-0 ps-0 pt-0 pb-3" colspan="2">
                        <strong style="color: red;">
                            Anticipo a pagar
                            <t t-if="advance_count > 1">
                                (<span t-esc="advance_count"/> servicios)
                            </t>
                        </strong>
                    </td>
                    <td class="text-end border-0 pe-0 pt-0 pb-3">
                        <strong style="color: red;">$
                            <span t-esc="'%.2f' % total_advance"/>
                        </strong>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
    <template id="payment_confirmation_status" inherit_id="website_sale.payment_confirmation_status">
        <xpath expr="//div[hasclass('card-header')]/t[3]" position="replace">
            <p>¡Tu anticipo ha sido registrado con éxito! Muchas gracias.
                
                <br/>
                El monto restante lo cubres en efectivo el día de tu cita, directamente en la sucursal. ¡Te esperamos!</p>
        </xpath>
    </template>
    <template id="appointment_info" inherit_id="appointment.appointment_meeting_details">
        <xpath expr="//div[2]/div[1]" position="after">
            <!-- 
        <t t-set="calendar_booking_ids" t-value="website_sale_order.website_order_line.calendar_booking_ids.appointment_type_id"/>-->
            <t t-if="appointment_type.advance_type and appointment_type.advance_type=='advance_percentage'">
                <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                    <i class="fa fa-calendar fa-fw me-2 mt-1 text-muted"/>
                    <strong style="color: red;">Aparta con   
                        $<span style="{color:red;}" t-esc="'%.2f'% (appointment_type.product_lst_price*(appointment_type.advance_percentage)/100)"/></strong>
                </div>
            </t>
            <t t-if="appointment_type.advance_type and appointment_type.advance_type=='fixed_import'">
                <div class="d-flex py-1 px-0 bg-transparent o-cc1-text border-0">
                    <i class="fa fa-calendar fa-fw me-2 mt-1 text-muted"/>
                    <strong style="color: red;">Aparta con   
                        $<span style="{color:red;}" t-esc="'%.2f'% (appointment_type.fixed_import)"/></strong>
                </div>
            </t>
        </xpath>
    </template>
</odoo>