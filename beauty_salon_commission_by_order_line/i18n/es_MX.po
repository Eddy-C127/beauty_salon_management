#. module: beauty_salon_commission_by_order_line
#: model:ir.model.fields,field_description:beauty_salon_commission_by_order_line.field_sale_order_line__user_id
msgid "Salesperson"
msgstr "Vendedor"

#. module: beauty_salon_commission_by_order_line
#: model:ir.model.fields,help:beauty_salon_commission_by_order_line.field_sale_order_line__user_id
msgid "Employee responsible for this line. Auto-filled from appointment if exists. Can be manually edited. Falls back to order salesperson if no appointment."
msgstr "Empleado responsable de esta línea. Se auto-llena desde la cita si existe. Puede ser editado manualmente. Si no hay cita, usa el vendedor de la orden."

