<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== TREE VIEW ==================== -->
    <record id="view_n8n_webhook_config_tree" model="ir.ui.view">
        <field name="name">n8n.webhook.config.tree</field>
        <field name="model">n8n.webhook.config</field>
        <field name="arch" type="xml">
            <list string="Webhooks n8n">
                <field name="name"/>
                <field name="webhook_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_n8n_webhook_config_form" model="ir.ui.view">
        <field name="name">n8n.webhook.config.form</field>
        <field name="model">n8n.webhook.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de Webhook n8n">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej: Confirmar Pago WhatsApp"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Conexión">
                            <field name="webhook_url" placeholder="https://n8n.tudominio.com/webhook/..."/>
                            <field name="auth_token" password="True"
                                   placeholder="Bearer token (opcional)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_n8n_webhook_config" model="ir.actions.act_window">
        <field name="name">Webhooks n8n</field>
        <field name="res_model">n8n.webhook.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura tu primer webhook de n8n
            </p>
            <p>
                Agrega las URLs de los webhooks de n8n a los que Odoo
                notificará cuando una cita sea confirmada y pagada.
            </p>
        </field>
    </record>

    <!-- ==================== MENÚ ==================== -->
    <menuitem id="menu_n8n_integration_root"
              name="Integración n8n"
              sequence="90"
              web_icon="n8n_whatsapp_appointment,static/src/img/icon.png"/>

    <menuitem id="menu_n8n_webhook_config"
              name="Webhooks Salientes"
              parent="menu_n8n_integration_root"
              action="action_n8n_webhook_config"
              sequence="10"/>

</odoo>
