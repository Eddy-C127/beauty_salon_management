<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hereda la vista form de calendar.event para mostrar campos de integración n8n -->
    <record id="view_calendar_event_form_n8n" model="ir.ui.view">
        <field name="name">calendar.event.form.n8n</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">

            <!-- Añadimos un página/tab "Integración n8n" al notebook existente -->
            <xpath expr="//notebook" position="inside">
                <page string="Integración n8n" name="n8n_integration"
                      invisible="not is_from_n8n">
                    <group string="Datos de Reserva WhatsApp">
                        <field name="is_from_n8n" readonly="1"/>
                        <field name="n8n_reservation_id" readonly="1"/>
                        <field name="n8n_status" readonly="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
