<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Herencia de Vista de Formulario de Appointment Type -->
    <record id="appointment_type_view_form_inherit" model="ir.ui.view">
        <field name="name">appointment.type.view.form.inherit</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campo de categorías Many2many después de appointment_duration con label propio -->
            <xpath expr="//div[field[@name='appointment_duration']]" position="after">
                <label for="appointment_category_ids" string="Categorías de Servicio"/>
                <div>
                    <field name="appointment_category_ids" 
                           widget="many2many_tags"
                           options="{'color_field': 'color', 'no_create_edit': True}"
                           placeholder="Seleccione categorías..."/>
                </div>
            </xpath>
            
            <!-- Agregar estado de disponibilidad en el header -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_mass_availability_wizard)d" 
                            string="Gestión de Disponibilidad" 
                            type="action"
                            class="btn-primary"
                            groups="appointment.group_appointment_manager"/>
                </header>
            </xpath>
            
            <!-- Campo invisible en formulario -->
            <xpath expr="//field[@name='category_time_display']" position="after">
                <field name="availability_status" 
                       invisible="1"/>
                <field name="is_manually_closed" invisible="1"/>
            </xpath>
            
        </field>
    </record>
    
    <!-- Herencia de Vista de Lista de Appointment Type -->
    <record id="appointment_type_view_tree_inherit" model="ir.ui.view">
        <field name="name">appointment.type.view.tree.inherit</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_tree"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campos en la lista -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="appointment_category_ids" 
                       widget="many2many_tags" 
                       optional="show"/>
                <field name="availability_status" 
                       optional="show"
                       decoration-success="availability_status and '✅' in availability_status"
                       decoration-danger="availability_status and '🔒' in availability_status"
                       decoration-warning="availability_status and '⏰' in availability_status or availability_status and '⏱️' in availability_status"/>
            </xpath>
            
        </field>
    </record>
    
    <!-- Herencia de Vista de Búsqueda de Appointment Type -->
    <record id="appointment_type_view_search_inherit" model="ir.ui.view">
        <field name="name">appointment.type.view.search.inherit</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_search"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campo de búsqueda por categoría -->
            <xpath expr="//field[@name='category']" position="after">
                <field name="appointment_category_ids"/>
            </xpath>
            
            <!-- Filtros por estado de disponibilidad -->
            <xpath expr="//filter[@name='filter_active']" position="before">
                <separator/>
                <filter string="✅ Disponibles" 
                        name="filter_available" 
                        domain="[('availability_status', 'ilike', '✅')]"/>
                <filter string="🔒 Cerradas" 
                        name="filter_closed" 
                        domain="[('availability_status', 'ilike', '🔒')]"/>
                <filter string="⏰ Próximamente" 
                        name="filter_upcoming" 
                        domain="['|', ('availability_status', 'ilike', '⏰'), ('availability_status', 'ilike', '⏱️')]"/>
                <separator/>
                <filter string="Pestañas" 
                        name="filter_pestanas" 
                        domain="[('appointment_category_ids.code', '=', 'pestanas')]"/>
                <filter string="Cejas" 
                        name="filter_cejas" 
                        domain="[('appointment_category_ids.code', '=', 'cejas')]"/>
                <filter string="Tattoo Lips" 
                        name="filter_tattoo_lips" 
                        domain="[('appointment_category_ids.code', '=', 'tattoo_lips')]"/>
                <filter string="Tattoo Brows" 
                        name="filter_tattoo_brows" 
                        domain="[('appointment_category_ids.code', '=', 'tattoo_brows')]"/>
                <separator/>
            </xpath>
            
            <!-- Agregar agrupaciones -->
            <xpath expr="//filter[@name='group_by_category']" position="after">
                <filter string="Categorías de Servicio" 
                        name="group_by_appointment_categories" 
                        context="{'group_by': 'appointment_category_ids'}"/>
            </xpath>
            
        </field>
    </record>

</odoo>