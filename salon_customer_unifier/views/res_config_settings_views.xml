<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_salon" model="ir.ui.view">
        <field name="name">salon.customer.unifier.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Citas Salón"
                     string="Citas Salón"
                     name="salon_customer_unifier">

                    <block title="Citas Salón">
                        <setting string="Modalidad de agendamiento público"
                                 help="Los clientes agendan como invitados sin necesidad de crear cuenta ni iniciar sesión. Se identifican únicamente por su número de teléfono. Oculta los botones «Iniciar sesión» y «Registrarse» en el flujo de citas y confirmación de pago.">
                            <field name="salon_public_booking_mode"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
