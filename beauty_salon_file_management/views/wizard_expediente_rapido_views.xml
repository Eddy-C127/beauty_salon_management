<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WIZARD: Completar Expediente Rápido
         Se muestra antes del wizard de inicio de cita cuando el expediente
         de la clienta está incompleto para el nivel del servicio.
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_wizard_expediente_rapido_form" model="ir.ui.view">
        <field name="name">popstudio.wizard.expediente.rapido.form</field>
        <field name="model">popstudio.wizard.expediente.rapido</field>
        <field name="arch" type="xml">
            <form string="Completar Expediente">

                <!-- Encabezado: contexto de la cita -->
                <div class="alert alert-warning mb-3" role="alert">
                    <h5 class="alert-heading mb-1">
                        <i class="fa fa-exclamation-triangle"/> Expediente Incompleto
                    </h5>
                    <p class="mb-0 small">
                        El expediente de <strong><field name="partner_nombre" readonly="1" nolabel="1"/></strong>
                        requiere información adicional para el servicio
                        <strong><field name="servicio_nombre" readonly="1" nolabel="1"/></strong>
                        <span invisible="nivel_requerido == 'basico'">
                            (nivel <strong><field name="nivel_requerido" readonly="1" nolabel="1"/></strong>).
                        </span>
                        <br/>
                        <em>Por favor completa solo los campos que se muestran a continuación.</em>
                    </p>
                </div>

                <!-- Campos faltantes (solo los que aplica) -->
                <group>

                    <!-- Aviso de Privacidad — siempre requerido -->
                    <div class="ps-field-faltante" invisible="not falta_aviso">
                        <div class="alert alert-danger py-2 px-3 mb-2" role="alert">
                            <i class="fa fa-shield"/> <strong>LFPDPPP — Aviso de Privacidad</strong>
                        </div>
                        <field name="aviso_privacidad_aceptado"
                               widget="boolean_toggle"
                               string="La clienta confirma haber leído y acepta el Aviso de Privacidad de Pop Studio"
                               invisible="not falta_aviso"/>
                    </div>

                    <!-- Alergias -->
                    <div class="ps-field-faltante" invisible="not falta_alergias">
                        <label for="alergias" class="fw-bold text-danger">
                            <i class="fa fa-exclamation-triangle"/> Alergias Conocidas *
                        </label>
                        <field name="alergias"
                               placeholder='Escribe "Ninguna conocida" si no hay alergias. Documenta alergias a productos, tintes, látex, materiales...'
                               nolabel="1"
                               invisible="not falta_alergias"/>
                    </div>

                    <!-- Condiciones Médicas -->
                    <div class="ps-field-faltante" invisible="not falta_condiciones">
                        <label for="condiciones_medicas" class="fw-bold">
                            <i class="fa fa-stethoscope"/> Condiciones Médicas *
                        </label>
                        <field name="condiciones_medicas"
                               placeholder='Escribe "Ninguna" si no aplica. Diabetes, embarazo, psoriasis, tratamientos activos...'
                               nolabel="1"
                               invisible="not falta_condiciones"/>
                    </div>

                    <!-- Tipo de Piel -->
                    <group invisible="not falta_tipo_piel">
                        <field name="tipo_piel"
                               widget="radio"
                               options="{'horizontal': true}"
                               invisible="not falta_tipo_piel"/>
                    </group>

                </group>

                <!-- Sección de Bypass (siempre disponible) -->
                <div class="mt-3 border-top pt-3">
                    <details>
                        <summary class="text-muted small" style="cursor: pointer;">
                            <i class="fa fa-forward"/> ¿Necesitas continuar sin completar? (Emergencia)
                        </summary>
                        <div class="mt-2">
                            <field name="motivo_bypass"
                                   placeholder="Motivo para omitir el expediente (queda registrado en la auditoría)..."
                                   nolabel="1"/>
                        </div>
                    </details>
                </div>

                <!-- Footer con botones -->
                <footer>
                    <button name="action_guardar_y_continuar"
                            string="Guardar y Continuar"
                            type="object"
                            class="btn btn-primary"
                            icon="fa-arrow-right"
                            invisible="not hay_campos_faltantes"/>
                    <button name="action_guardar_y_continuar"
                            string="Continuar"
                            type="object"
                            class="btn btn-success"
                            icon="fa-check"
                            invisible="hay_campos_faltantes"/>
                    <button name="action_omitir_expediente"
                            string="Omitir"
                            type="object"
                            class="btn btn-warning ms-2"
                            icon="fa-forward"
                            confirm="¿Confirmas iniciar la cita sin completar el expediente? Esta acción quedará registrada en la auditoría."/>
                    <button string="Cancelar"
                            class="btn btn-secondary ms-1"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
