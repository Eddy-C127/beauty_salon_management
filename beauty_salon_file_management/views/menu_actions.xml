              groups="beauty_salon_file_management.group_popstudio_manager"/>

    <menuitem id="menu_dashboard_citas"
              name="📈 Dashboard de Citas"
              parent="menu_popstudio_auditoria"
              action="action_dashboard_citas"
              sequence="5"
              groups="beauty_salon_file_management.group_popstudio_manager"/>

    <menuitem id="menu_auditoria_expedientes"
              name="📋 Reporte de Cumplimiento"
              parent="menu_popstudio_auditoria"
              action="action_auditoria_expedientes"
              sequence="10"
              groups="beauty_salon_file_management.group_popstudio_manager"/>

    <menuitem id="menu_auditoria_faltantes"
              name="❌ Expedientes Faltantes"
              parent="menu_popstudio_auditoria"
              action="action_expedientes_faltantes"
              sequence="20"
              groups="beauty_salon_file_management.group_popstudio_manager"/>

    <menuitem id="menu_auditoria_todas_sesiones"
              name="📋 Todas las Sesiones"
              parent="menu_popstudio_auditoria"
              action="action_todas_sesiones_auditoria"
              sequence="30"
              groups="beauty_salon_file_management.group_popstudio_manager"/>

</odoo>
