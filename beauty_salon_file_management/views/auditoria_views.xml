<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DASHBOARD DE AUDITORÍA - EXPEDIENTES POP STUDIO
         Vistas Pivot, Graph, Búsqueda y acciones de dashboard
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ══════════════════════════════════════════════════════════════════════
         BÚSQUEDA DEDICADA PARA DASHBOARD
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_dashboard_auditoria_search" model="ir.ui.view">
        <field name="name">calendar.event.dashboard.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search string="Dashboard de Citas">
                <field name="real_employee_id" string="Artista"/>
                <field name="manual_customer_id" string="Clienta"/>
                <field name="appointment_type_id" string="Servicio"/>
                <separator/>

                <!-- ── Filtros por Estado ── -->
                <filter string="Concluidas" name="concluidas"
                        domain="[('appointment_status', '=', 'concluded')]"/>
                <filter string="En Curso" name="en_curso"
                        domain="[('appointment_status', '=', 'attended')]"/>
                <filter string="Reservadas" name="reservadas"
                        domain="[('appointment_status', '=', 'booked')]"/>
                <separator/>

                <!-- ── Filtros de Expediente ── -->
                <filter string="Con Expediente" name="con_expediente"
                        domain="[('expediente_completado', '=', True)]"
                        icon="fa-check-circle"/>
                <filter string="Sin Expediente" name="sin_expediente"
                        domain="[('expediente_completado', '=', False)]"
                        icon="fa-times-circle"/>
                <separator/>

                <!-- ── Filtros de Fecha ── -->
                <filter string="Hoy" name="hoy"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                  ('start', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Esta Semana" name="esta_semana"
                        domain="[('start', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Quincena" name="quincena"
                        domain="[('start', '&gt;=', (context_today() - relativedelta(days=15)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este Mes" name="este_mes"
                        domain="[('start', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Mes Anterior" name="mes_anterior"
                        domain="[('start', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')),
                                  ('start', '&lt;', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>

                <!-- ── Agrupar Por ── -->
                <group expand="1" string="Agrupar Por">
                    <filter string="Artista" name="group_artista"
                            context="{'group_by': 'real_employee_id'}"/>
                    <filter string="Servicio" name="group_servicio"
                            context="{'group_by': 'appointment_type_id'}"/>
                    <filter string="Estado Cita" name="group_estado"
                            context="{'group_by': 'appointment_status'}"/>
                    <filter string="Expediente" name="group_expediente"
                            context="{'group_by': 'expediente_completado'}"/>
                    <separator/>
                    <filter string="Dia" name="group_dia"
                            context="{'group_by': 'start:day'}"/>
                    <filter string="Semana" name="group_semana"
                            context="{'group_by': 'start:week'}"/>
                    <filter string="Mes" name="group_mes"
                            context="{'group_by': 'start:month'}"/>
                    <filter string="Trimestre" name="group_trimestre"
                            context="{'group_by': 'start:quarter'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         GRÁFICA: Barra Apilada — Citas por Artista (Completo vs Faltante)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_dashboard_graph_bar" model="ir.ui.view">
        <field name="name">calendar.event.dashboard.graph.bar</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <graph string="Citas por Artista"
                   type="bar"
                   stacked="True"
                   sample="1">
                <field name="real_employee_id" type="row" string="Artista"/>
                <field name="expediente_completado_count" type="measure" string="Expedientes Completos"/>
                <field name="expediente_faltante_count" type="measure" string="Expedientes Faltantes"/>
            </graph>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         GRÁFICA: Pie — Proporción Expedientes Completos vs Faltantes
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_dashboard_graph_pie" model="ir.ui.view">
        <field name="name">calendar.event.dashboard.graph.pie</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <graph string="Estado de Expedientes"
                   type="pie"
                   sample="1">
                <field name="expediente_completado" type="row" string="Expediente Completo"/>
            </graph>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         GRÁFICA: Línea — Tendencia de Citas por Periodo
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_dashboard_graph_line" model="ir.ui.view">
        <field name="name">calendar.event.dashboard.graph.line</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <graph string="Tendencia de Citas"
                   type="line"
                   sample="1">
                <field name="start" type="row" interval="week" string="Semana"/>
                <field name="expediente_completado_count" type="measure" string="Completos"/>
                <field name="expediente_faltante_count" type="measure" string="Faltantes"/>
            </graph>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         PIVOT: Detalle por Artista y Periodo
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_dashboard_pivot" model="ir.ui.view">
        <field name="name">calendar.event.dashboard.pivot</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <pivot string="Detalle de Citas y Expedientes"
                   disable_linking="false"
                   sample="1">
                <field name="real_employee_id" type="row" string="Artista"/>
                <field name="start" type="col" string="Periodo" interval="month"/>
                <field name="expediente_completado_count" type="measure" string="Completos"/>
                <field name="expediente_faltante_count" type="measure" string="Faltantes"/>
            </pivot>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACCIÓN PRINCIPAL: Dashboard de Citas
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_dashboard_citas" model="ir.actions.act_window">
        <field name="name">Dashboard de Citas</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_dashboard_graph_bar')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_dashboard_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_calendar_event_popstudio_list')}),
        ]"/>
        <field name="search_view_id" ref="view_dashboard_auditoria_search"/>
        <field name="domain">[('appointment_status', 'in', ['concluded', 'attended', 'booked'])]</field>
        <field name="context">{
            'search_default_este_mes': 1,
            'search_default_group_artista': 1,
            'graph_measure': 'expediente_completado_count',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin datos para el periodo seleccionado
            </p>
            <p>
                Ajusta los filtros de fecha para ver estadísticas de citas y expedientes.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACCIÓN: Reporte de Auditoría (existente, mejorada)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_auditoria_expedientes" model="ir.actions.act_window">
        <field name="name">Auditoria de Expedientes</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_dashboard_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_dashboard_graph_bar')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_calendar_event_popstudio_list')}),
        ]"/>
        <field name="search_view_id" ref="view_dashboard_auditoria_search"/>
        <field name="domain">[('appointment_status', 'in', ['concluded', 'attended'])]</field>
        <field name="context">{
            'search_default_este_mes': 1,
            'search_default_group_artista': 1,
            'pivot_measures': ['expediente_completado_count', 'expediente_faltante_count'],
            'pivot_row_groupby': ['real_employee_id'],
            'pivot_column_groupby': ['start:month'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin datos de auditoría
            </p>
            <p>
                Los datos aparecen al procesar citas con el flujo
                Iniciar / Concluir Cita.
            </p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACCIÓN: Expedientes Faltantes (alerta roja)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_expedientes_faltantes" model="ir.actions.act_window">
        <field name="name">Expedientes Faltantes</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_calendar_event_popstudio_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_calendar_event_popstudio_form')}),
        ]"/>
        <field name="domain">[
            ('appointment_status', '=', 'concluded'),
            ('expediente_completado', '=', False)
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin expedientes faltantes
            </p>
            <p>
                Todas las citas concluidas tienen su expediente completo.
            </p>
        </field>
    </record>

    <!-- ── ACCIÓN: Todas las Sesiones ────────────────────────────────── -->
    <record id="action_todas_sesiones_auditoria" model="ir.actions.act_window">
        <field name="name">Todas las Sesiones</field>
        <field name="res_model">popstudio.expediente.sesion</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_expediente_sesion_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
