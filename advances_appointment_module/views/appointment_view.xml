<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="advances_appointment_payment_form" model="ir.ui.view">
        <field name="name">advances_appointment_payment.form</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//label[@for='has_payment_step']/div[1]" position="after"><div><div class="o_row mw-75 mw-md-100"><field name="apply_advance"/><field name="advance_percentage" invisible="apply_advance==False"/></div></div></xpath>-->
            <xpath expr="//group[@name='options_left_details']" position="inside">
                <field name="apply_advance"/>
                <field invisible="apply_advance==False" name="advance_percentage"/>
            </xpath>
        </field>
    </record>
</odoo>