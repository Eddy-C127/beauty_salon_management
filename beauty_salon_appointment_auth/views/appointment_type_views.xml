<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista de Formulario -->
    <record id="appointment_type_view_form_auth" model="ir.ui.view">
        <field name="name">appointment.type.form.auth</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campo en la página de configuración (sheet) -->
            <xpath expr="//sheet" position="inside">
                
                <group name="authentication_settings" string="Authentication Settings">
                    <field name="require_login"/>
                    
                    <!-- Mensaje de ayuda cuando está activado -->
                    <div class="alert alert-info mt-2" 
                         role="alert"
                         invisible="not require_login"
                         colspan="2">
                        <strong>🔒 Authentication Required</strong>
                        <p class="mb-0">
                            Users must login or create an account before booking this appointment.
                            This prevents duplicate contacts and ensures better customer tracking.
                        </p>
                    </div>
                    
                    <!-- Mensaje de advertencia cuando está desactivado -->
                    <div class="alert alert-warning mt-2" 
                         role="alert"
                         invisible="require_login"
                         colspan="2">
                        <strong>⚠️ Public Booking Enabled</strong>
                        <p class="mb-0">
                            Users can book without login. This may create duplicate contacts 
                            if they later create an account during checkout.
                        </p>
                    </div>
                </group>
                
            </xpath>
            
        </field>
    </record>

</odoo>