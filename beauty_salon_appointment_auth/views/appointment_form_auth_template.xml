<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 
        Solución minimalista que se integra perfectamente con el ecosistema de Odoo:
        - Usa CSS para ocultar botones cuando es público
        - No modifica el DOM de botones existentes
        - Compatible con website_appointment_sale y otros módulos
    -->
    <template id="appointment_form_auth_buttons" 
              inherit_id="appointment.appointment_form" 
              name="Appointment Form - Auth Buttons"
              priority="99">
        
        <!-- 
            Agregar sección de autenticación ANTES del formulario
            Solo visible cuando: usuario público Y require_login=True
        -->
        <xpath expr="//form[hasclass('appointment_submit_form')]" position="before">
            
            <t t-if="request.env.user._is_public() and appointment_type.require_login">
                
                <!-- Agregar clase CSS al body para ocultar botones de submit -->
                <t t-set="hide_submit_buttons" t-value="True"/>
                
                <!-- Mensaje informativo -->
                <div class="alert alert-warning mb-4" role="alert">
                    <div class="d-flex align-items-start">
                        <i class="fa fa-lock fa-2x me-3 mt-1"/>
                        <div>
                            <h6 class="alert-heading mb-1">Sign in to continue</h6>
                            <p class="mb-0 small">
                                You need to have an account to book 
                                <strong t-esc="appointment_type.name"/>.
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Botones de login/signup -->
                <div class="text-end mb-4">
                    <div class="d-inline-flex gap-2">
                        <a href="#" class="btn btn-outline-secondary o_appointment_auth_login_btn">
                            <i class="fa fa-sign-in me-1"/>
                            I already have an account
                        </a>
                        <a href="#" class="btn btn-primary o_appointment_auth_signup_btn">
                            <i class="fa fa-user-plus me-1"/>
                            Create an account
                        </a>
                    </div>
                </div>
                
                <!-- CSS para ocultar TODOS los botones de submit -->
                <style>
                    .o_appointment_form_confirm_btn,
                    button[type="submit"].btn-primary,
                    .appointment_submit_form button.btn-primary {
                        display: none !important;
                    }
                </style>
                
                <!-- JavaScript para construir URLs y asegurar que botones estén ocultos -->
                <script type="text/javascript">
                    (function() {
                        // Construir URLs de redirect
                        var currentUrl = window.location.pathname + window.location.search;
                        var redirectParam = encodeURIComponent(currentUrl);
                        
                        var loginBtn = document.querySelector('.o_appointment_auth_login_btn');
                        var signupBtn = document.querySelector('.o_appointment_auth_signup_btn');
                        
                        if (loginBtn) loginBtn.href = '/web/login?redirect=' + redirectParam;
                        if (signupBtn) signupBtn.href = '/web/signup?redirect=' + redirectParam;
                        
                        // Asegurar que todos los botones de submit estén ocultos
                        document.addEventListener('DOMContentLoaded', function() {
                            var submitButtons = document.querySelectorAll('.o_appointment_form_confirm_btn, button[type="submit"].btn-primary');
                            submitButtons.forEach(function(btn) {
                                btn.style.display = 'none';
                            });
                        });
                    })();
                </script>
                
            </t>
            
        </xpath>
        
    </template>
    
</odoo>
