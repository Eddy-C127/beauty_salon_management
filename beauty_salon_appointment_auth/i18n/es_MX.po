#. module: beauty_salon_appointment_auth
#: model:ir.model.fields,field_description:beauty_salon_appointment_auth.field_appointment_type__require_login
msgid "Require Login to Book"
msgstr "Requiere inicio de sesión para reservar"

#. module: beauty_salon_appointment_auth
#: model:ir.model.fields,help:beauty_salon_appointment_auth.field_appointment_type__require_login
msgid ""
"If enabled, users must login or create an account before booking.\n"
"This prevents duplicate contact creation and ensures better traceability.\n"
"\n"
"• Disabled: Users can book without login (may create duplicates)\n"
"• Enabled: Users must authenticate first (recommended for all services)"
msgstr ""
"Si está activado, los usuarios deben iniciar sesión o crear una cuenta antes de reservar.\n"
"Esto previene la creación de contactos duplicados y asegura mejor rastreabilidad.\n"
"\n"
"• Desactivado: Los usuarios pueden reservar sin iniciar sesión (puede crear duplicados)\n"
"• Activado: Los usuarios deben autenticarse primero (recomendado para todos los servicios)"

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_type_view_form_auth
msgid "Authentication Settings"
msgstr "Configuración de autenticación"

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_type_view_form_auth
msgid "🔒 Authentication Required"
msgstr "🔒 Autenticación requerida"

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_type_view_form_auth
msgid ""
"Users must login or create an account before booking this appointment.\n"
"This prevents duplicate contacts and ensures better customer tracking."
msgstr ""
"Los usuarios deben iniciar sesión o crear una cuenta antes de reservar esta cita.\n"
"Esto previene contactos duplicados y asegura un mejor seguimiento de clientes."

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_type_view_form_auth
msgid "⚠️ Public Booking Enabled"
msgstr "⚠️ Reservación pública activada"

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_type_view_form_auth
msgid ""
"Users can book without login. This may create duplicate contacts\n"
"if they later create an account during checkout."
msgstr ""
"Los usuarios pueden reservar sin iniciar sesión. Esto puede crear contactos duplicados\n"
"si después crean una cuenta durante el proceso de pago."

#. module: beauty_salon_appointment_auth
#: model_terms:ir.ui.view,arch_db:beauty_salon_appointment_auth.appointment_form_auth_buttons
msgid "Sign in to continue"
msgstr "Inicia sesión para continuar"

