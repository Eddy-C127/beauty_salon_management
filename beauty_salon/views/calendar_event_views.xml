<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- ===== VISTA FORM PRINCIPAL (appointment) ===== -->
    <record id="view_calendar_event_form_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.beauty.salon</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Crear header ANTES del sheet -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_create_sale_order"
                            string="Crear Orden"
                            type="object"
                            class="oe_highlight"
                            invisible="has_sale_order or not appointment_type_id or not manual_customer_id"
                            groups="sales_team.group_sale_salesman"/>
                    <field name="has_sale_order" invisible="1"/>
                </header>
            </xpath>

            <!-- SOLO AGREGAR CAMPOS CUSTOM - NO TOCAR LOS NATIVOS -->

            <!-- 1. Cliente (manual_customer_id) - ANTES de appointment_type_id -->
            <xpath expr="//field[@name='appointment_type_id']" position="before">
                <field name="manual_customer_id"
                       string="Cliente"
                       options="{'no_create': False}"
                       placeholder="Buscar o crear cliente..."/>
            </xpath>

            <!-- 2. Empleado Real DESPUÉS de appointment_status -->
            <xpath expr="//field[@name='appointment_status']" position="after">
                <field name="real_employee_id" 
                    string="Empleado Real"
                    domain="[('is_virtual_resource', '=', False), ('active', '=', True)]"/>
            </xpath>

            <!-- 3. Buscar disponibilidad + Slots inline + Orden de Venta - DESPUÉS de real_employee_id -->
            <xpath expr="//field[@name='real_employee_id']" position="after">
                <field name="overlap_warning"
                       readonly="1"
                       invisible="not overlap_warning"
                       style="color: #b45309; background: #fff8e1; border: 1px solid #f9a825; border-radius: 6px; padding: 6px 10px; display: block;"/>
                <field name="slot_search_date"
                       string="Buscar disponibilidad para el día"
                       invisible="not appointment_type_id or not real_employee_id"
                       widget="date"/>
                <field name="selected_slot_id"
                       string="Horario disponible"
                       widget="radio"
                       class="ps-slot-chips"
                       domain="[('id', 'in', available_slot_ids)]"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not slot_search_date or not appointment_type_id or not real_employee_id or not available_slot_ids"/>
                <field name="no_slots_message"
                       readonly="1"
                       invisible="not no_slots_message"/>
                <field name="available_slot_ids" invisible="1"/>
                <field name="sale_order_id"
                       readonly="1"
                       invisible="not sale_order_id"
                       string="Orden de Venta"
                       options="{'no_open': False, 'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <!-- ===== VISTA FORM GANTT BOOKING ===== -->
    <record id="view_calendar_event_form_inherit_beauty_salon_gantt" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.beauty.salon.gantt</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_form_gantt_booking"/>
        <field name="arch" type="xml">
            
            <!-- ISSUE 2: Botón en footer ANTES de Guardar -->
            <xpath expr="//footer/button[@special='save']" position="before">
                <button name="action_create_sale_order"
                        string="Crear Orden"
                        type="object"
                        class="oe_highlight"
                        invisible="has_sale_order or not appointment_type_id or not manual_customer_id"
                        groups="sales_team.group_sale_salesman"/>
                <field name="has_sale_order" invisible="1"/>
            </xpath>

            <!-- SOLO AGREGAR CAMPOS CUSTOM - NO TOCAR LOS NATIVOS -->

            <!-- 1. Cliente ANTES de appointment_type_id -->
            <xpath expr="//field[@name='appointment_type_id']" position="before">
                <field name="manual_customer_id"
                       string="Cliente"
                       options="{'no_create': False}"
                       placeholder="Buscar o crear cliente..."/>
            </xpath>

            <!-- 2. Empleado Real DESPUÉS de appointment_status -->
            <xpath expr="//field[@name='appointment_status']" position="after">
                <field name="real_employee_id" string="Empleado Real"/>
            </xpath>

            <!-- 3. Buscar disponibilidad + Slots inline + Orden de Venta DESPUÉS de real_employee_id -->
            <xpath expr="//field[@name='real_employee_id']" position="after">
                <field name="overlap_warning"
                       readonly="1"
                       invisible="not overlap_warning"
                       style="color: #b45309; background: #fff8e1; border: 1px solid #f9a825; border-radius: 6px; padding: 6px 10px; display: block;"/>
                <field name="slot_search_date"
                       string="Buscar disponibilidad para el día"
                       invisible="not appointment_type_id or not real_employee_id"
                       widget="date"/>
                <field name="selected_slot_id"
                       string="Horario disponible"
                       widget="radio"
                       class="ps-slot-chips"
                       domain="[('id', 'in', available_slot_ids)]"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not slot_search_date or not appointment_type_id or not real_employee_id or not available_slot_ids"/>
                <field name="no_slots_message"
                       readonly="1"
                       invisible="not no_slots_message"/>
                <field name="available_slot_ids" invisible="1"/>
                <field name="sale_order_id"
                       readonly="1"
                       invisible="not sale_order_id"
                       string="Orden de Venta"
                       options="{'no_open': False, 'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <!-- ===== VISTA TREE ===== -->
    <record id="view_calendar_event_tree_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">calendar.event.tree.inherit.beauty.salon</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_tree_booking"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attendee_ids']" position="after">
                <field name="manual_customer_id" string="Cliente" optional="show"/>
                <field name="real_employee_id" string="Empleado Real" optional="show"/>
                <field name="sale_order_id" string="Orden de Venta" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ===== VISTA GANTT ===== -->
    <record id="view_calendar_event_gantt_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">calendar.event.gantt.inherit.beauty.salon</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_gantt_booking_resource"/>
        <field name="arch" type="xml">
            
            <!-- Agregar campos custom al gantt -->
            <xpath expr="//gantt" position="inside">
                <field name="manual_customer_id"/>
                <field name="real_employee_id"/>
                <field name="sale_order_id"/>
            </xpath>

            <!-- Popover con información de campos custom -->
            <xpath expr="//templates/div[@t-name='gantt-popover']/ul" position="inside">
                <li t-if="manual_customer_id">
                    <strong>Cliente: </strong>
                    <span t-esc="manual_customer_id ? (manual_customer_id[1] || manual_customer_id) : ''"/>
                </li>
                <li t-if="real_employee_id">
                    <strong>Empleado Real: </strong>
                    <span t-esc="real_employee_id ? (real_employee_id[1] || real_employee_id) : ''"/>
                </li>
                <li t-if="sale_order_id">
                    <strong>Orden de Venta: </strong>
                    <span t-esc="sale_order_id ? (sale_order_id[1] || sale_order_id) : ''"/>
                </li>
            </xpath>

            <!-- Reemplazar el selector de status con todas las opciones -->
            <xpath expr="//li[@t-if='appointment_status']" position="replace">
                <li t-if="appointment_status" class="o_field_selection d-flex align-items-center gap-2 mt-2">
                    <strong>Status: </strong>
                    <select t-if="can_edit" class="o_appointment_booking_status o_input">
                        <option value="request" t-att-selected="appointment_status === 'request'">Request</option>
                        <option value="booked" t-att-selected="appointment_status === 'booked'">Booked</option>
                        <option value="attended" t-att-selected="appointment_status === 'attended'">Checked-In</option>
                        <option value="concluded" t-att-selected="appointment_status === 'concluded'">Concluded</option>
                        <option value="no_show" t-att-selected="appointment_status === 'no_show'">No Show</option>
                        <option value="cancelled" t-att-selected="appointment_status === 'cancelled'">Cancelled</option>
                    </select>
                    <t t-else="">
                        <t t-if="appointment_status === 'request'">Request</t>
                        <t t-elif="appointment_status === 'booked'">Booked</t>
                        <t t-elif="appointment_status === 'attended'">Checked-In</t>
                        <t t-elif="appointment_status === 'concluded'">Concluded</t>
                        <t t-elif="appointment_status === 'no_show'">No Show</t>
                        <t t-elif="appointment_status === 'cancelled'">Cancelled</t>
                    </t>
                </li>
            </xpath>
            
        </field>
    </record>

</odoo>