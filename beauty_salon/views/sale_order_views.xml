<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_order_form_inherit_sale_stock_beauty_salon" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.stock.beauty.salon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="aux_branch_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.beauty.salon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="aux_branch_id"/>
            </xpath>
        </field>
    </record>
</odoo>
