<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- ===== VISTA FORM SALE ORDER ===== -->
    <record id="view_order_form_inherit_sale_stock_beauty_salon" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale.stock.beauty.salon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Agregar Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_calendar_event"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="not calendar_event_id"
                        groups="base.group_user">
                    <field name="calendar_event_id" widget="statinfo" string="Appointment"/>
                </button>
                                <!-- 🆕 NUEVO: Botón Actualizar Servicio -->
                <button name="action_sync_service_from_appointment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="state == 'cancel'"
                        groups="sales_team.group_sale_salesman"
                        help="Sincroniza los servicios de las líneas con los cambios realizados en las citas">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Actualizar</span>
                        <span class="o_stat_text">Servicio</span>
                    </div>
                </button>
            </xpath>

            <!-- Agregar campo aux_branch_id -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="aux_branch_id"/>
            </xpath>
        </field>
    </record>

    <!-- ===== VISTA TREE QUOTATIONS ===== -->
    <record id="view_quotation_tree_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.beauty.salon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="aux_branch_id"/>
                <field name="calendar_event_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
