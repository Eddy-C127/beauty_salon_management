<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_employee_form_inherit_beauty_salon" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.beauty.salon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_ids']" position="after">
                <field name="is_virtual_resource"/>
                <field name="default_real_employee_id" required="is_virtual_resource == True"/>
            </xpath>
        </field>
    </record>
</odoo>